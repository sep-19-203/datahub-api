# Mẫu cấu hình chạy local — SAO CHÉP ra ~/.config/hddt/data-api-local.env (chmod 600) rồi điền giá trị thật.
# KHÔNG commit file có credential.
. ~/.config/hddt/dse-dev.env            # DSE_CONTACT_POINTS, DSE_LOCAL_DC, DSE_USERNAME, DSE_PASSWORD
export DSE_JOB_KEYSPACE=datahub_hddt
export DSE_CREATE_SCHEMA=true          # tạo keyspace/bảng IF NOT EXISTS khi khởi động
export HDDT_DSE_REPLICATION="{'class': 'NetworkTopologyStrategy', 'DC1': '2'}"
export DORIS_JDBC_URL='jdbc:mysql://<doris-fe>:9030/?useSSL=false&connectTimeout=5000&socketTimeout=7300000'
export DORIS_USERNAME=<user>
export DORIS_PASSWORD=<password>
export S3_ENDPOINT=http://<minio>:9000
export S3_ACCESS_KEY=<access-key>
export S3_SECRET_KEY=<secret-key>
export S3_EXPORT_BUCKET=hddt
export S3_ALLOWED_INPUT_BUCKETS=hddt
export S3_DORIS_ENDPOINT=http://<minio>:9000   # endpoint mà Doris BE truy cập được (OUTFILE)
export EXPORT_ENGINE=OUTFILE                    # hoặc JDBC_STREAM nếu BE không tới được S3
export MST_STATUS_SOURCE_SQL="SELECT MST, TRANG_THAI FROM doris.NNT_HIS WHERE TD = '2100-01-01'"
# Không còn secret client (TD-API-40, 09/11): bên gọi theo header x-partner (TTHC/TMS).
# export ESB_HMAC_KEY=<= tthc.hmac.key của tthc-sharing>   # có ⇒ bắt buộc x-partner + x-hmac; không ⇒ không xác thực
export SERVER_PORT=18080
